o": "5 meses (suspendidos) + 9.600 €", "cifra": "5 meses + 9.600 €", "fuente": "CNN, 19-feb-2026", "texto": "Eso no lo hiciste tú. Lo hizo él. Cinco meses que no cumplirá. Él dice que fue un accidente.", "inicio": 33.95, "fin": 40.192}, {"tipo": "texto", "visual": "mensaje", "texto": "Lo difícil no es subir. Es decidir cuando ella ya no puede.", "inicio": 40.61, "fin": 44.27}, {"tipo": "cierre", "visual": "cierre", "titulo": "¿Y la tuya?", "texto": "¿Y tu pareja? ¿Te dejaría la manta?", "inicio": 44.69, "fin": 46.635}], "sonido": {"bajoVoz": 0.45, "efectos": [{"nombre": "viento", "inicio": {"escena": 0}, "fin": {"escena": "manana"}, "volumen": 0.4, "bucle": true, "fundido": [0, 0.15]}, {"nombre": "rotor", "inicio": {"escena": 0}, "fin": {"escena": "rebobina"}, "volumen": 0.7, "bucle": true, "bajoVoz": 0.3, "fundido": [0, 0.1]}, {"nombre": "zas", "inicio": {"escena": "rebobina"}, "duracion": 0.5, "volumen": 0.8}, {"nombre": "roce", "inicio": {"escena": "rebobina", "mas": 0.2}, "duracion": 1.2, "volumen": 0.5}, {"nombre": "zas", "inicio": {"escena": "manana"}, "duracion": 0.5, "volumen": 0.5}, {"nombre": "roce", "inicio": {"escena": "manana"}, "fin": {"escena": "noche"}, "volumen": 0.5, "bucle": true, "fundido": [0.1, 0.1]}, {"nombre": "pajaros", "inicio": {"escena": "manana"}, "fin": {"escena": "noche"}, "volumen": 0.3, "bucle": true, "fundido": [0.1, 0.2]}, {"nombre": "viento", "inicio": {"escena": "noche"}, "fin": {"escena": "juzgado"}, "volumen": 0.35, "bucle": true, "fundido": [0.3, 0.3]}, {"nombre": "rotor", "inicio": {"escena": "helicoptero"}, "fin": {"escena": "color"}, "volumen": 0.6, "bucle": true, "bajoVoz": 0.3, "fundido": [0.4, 0.6]}, {"nombre": "latido", "inicio": {"escena": "color"}, "fin": {"escena": "amanecer"}, "volumen": 0.6, "bucle": true, "bajoVoz": 0.2, "fundido": [0.3, 0.1]}, {"nombre": "vibra", "inicio": {"escena": "movil"}, "duracion": 1.3, "volumen": 0.7}, {"nombre": "rotor", "inicio": {"escena": "movil", "mas": 0.6}, "fin": {"escena": "amane