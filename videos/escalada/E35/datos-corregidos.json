, "inicio": 28.4, "fin": 32.024}, {"tipo": "texto", "visual": "amanecer", "texto": "Ella muere de hipotermia. A cincuenta metros de la cumbre.", "inicio": 32.52, "fin": 36.045}, {"tipo": "cifra", "visual": "juzgado", "titulo": "5 meses (suspendidos) + 9.600 €", "cifra": "5 meses + 9.600 €", "fuente": "CNN, 19-feb-2026", "texto": "Eso no lo hiciste tú. Lo hizo él. Cinco meses que no cumplirá. Él dice que fue un accidente.", "inicio": 36.58, "fin": 42.952}, {"tipo": "texto", "visual": "mensaje", "texto": "Lo difícil no es subir. Es decidir cuando ella ya no puede.", "inicio": 43.51, "fin": 47.27}, {"tipo": "cierre", "visual": "cierre", "titulo": "¿Y la tuya?", "texto": "¿Y tu pareja? ¿Te dejaría la manta?", "inicio": 47.89, "fin": 49.863}], "sonido": {"bajoVoz": 0.45, "efectos": [{"nombre": "viento", "inicio": {"escena": 0}, "fin": {"escena": "manana"}, "volumen": 0.4, "bucle": true, "fundido": [0, 0.15]}, {"nombre": "rotor", "inicio": {"escena": 0}, "fin": {"escena": "rebobina"}, "volumen": 0.7, "bucle": true, "bajoVoz": 0.3, "fundido": [0, 0.1]}, {"nombre": "zas", "inicio": {"escena": "rebobina"}, "duracion": 0.5, "volumen": 0.8}, {"nombre": "roce", "inicio": {"escena": "rebobina", "mas": 0.2}, "duracion": 1.2, "volumen": 0.5}, {"nombre": "zas", "inicio": {"escena": "manana"}, "duracion": 0.5, "volumen": 0.5}, {"nombre": "roce", "inicio": {"escena": "manana"}, "fin": {"escena": "noche"}, "volumen": 0.5, "bucle": true, "fundido": [0.1, 0.1]}, {"nombre": "pajaros", "inicio": {"escena": "manana"}, "fin": {"escena": "noche"}, "volumen": 0.3, "bucle": true, "fundido": [0.1, 0.2]}, {"nombre": "viento", "inicio": {"escena": "noche"}, "fin": {"escena": "juzgado"}, "volumen": 0.35, "bucle": true, "fundido": [0.3, 0.3]}, {"nombre": "rotor", "inicio": {"escena": "helicoptero"}, "fin": {"escena": "color"}, "volumen": 0.6, "bucle": true, "bajoVoz": 0.3, "fundido": [0.4, 0.6]}, {"nombre": "latido", "inicio": {"escena": "color"}, "fin": {"escena": "amanecer"}, "volumen": 0.6, "buc