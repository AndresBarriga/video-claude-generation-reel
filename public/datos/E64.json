  "escenas": [
    {
      "tipo": "gancho",
      "visual": "gancho",
      "bloque": "gancho",
      "texto": "Tu cinta está chapada… y la cuerda se sale igual.",
      "claves": [
        "chapada",
        "sale"
      ],
      "cifras": [],
      "inicio": 0,
      "fin": 2.885
    },
    {
      "tipo": "texto",
      "visual": "promesa",
      "bloque": "cifras",
      "texto": "Tres errores al chapar que lo provocan.",
      "claves": [
        "Tres",
        "errores"
      ],
      "cifras": [
        "2,7 m",
        "6,3 m"
      ],
      "inicio": 3.1,
      "fin": 4.947
    },
    {
      "tipo": "texto",
      "visual": "reencuadre",
      "bloque": "reencuadre",
      "texto": "No falla la cinta: falla cómo se coloca.",
      "claves": [
        "coloca"
      ],
      "cifras": [],
      "inicio": 5.16,
      "fin": 6.803
    },
    {
      "tipo": "texto",
      "visual": "backclip",
      "bloque": "dentro",
      "texto": "Uno: nada de back-clip. El tramo que va a tu arnés sale por delante, hacia ti. Al revés, al caer puede pasar por encima de la puerta… y salirse.",
      "claves": [
        "back-clip",
        "hacia ti"
      ],
      "cifras": [],
      "inicio": 8.54,
      "fin": 16.035
    },
    {
      "tipo": "texto",
      "visual": "giro",
      "bloque": "giro",
      "texto": "Pero aunque entre bien… se puede salir.",
      "claves": [
        "salir"
      ],
      "cifras": [],
      "inicio": 16.24,
      "fin": 18.186
    },
    {
      "tipo": "texto",
      "visual": "puerta",
      "bloque": "dentro",
      "texto": "Dos: la puerta del mosquetón de la cuerda, al lado contrario de hacia donde vas. ¿Vas a la derecha? Puerta a la izquierda. Si no, al caer la cuerda puede abrirla.",
      "claves": [
        "puerta",
        "izquierda"
      ],
      "cifras": [],
      "inicio": 18.4,
      "fin": 28.259
    },
    {
      "tipo": "texto",
      "visual": "goma",
      "bloque": "pasos",
      "texto": "Tres: esta cinta parece perfecta. Y está mal. El mosquetón sin goma, a la chapa; el de la goma, a la cuerda. No los cambies: la chapa marca el mosquetón… y esas marcas desgastan tu cuerda.",
      "claves": [
        "perfecta",
        "goma",
        "cambies"
      ],
      "cifras": [],
      "inicio": 28.82,
      "fin": 39.941
    },
    {
      "tipo": "texto",
      "visual": "repaso",
      "bloque": "porEso",
      "texto": "Por eso: cuerda hacia ti, puerta al otro lado, y la goma, siempre a la cuerda.",
      "claves": [
        "hacia ti",
        "otro lado",
        "goma"
      ],
      "cifras": [],
      "inicio": 40.72,
      "fin": 45.402
    },
    {
      "tipo": "cierre",
      "visual": "cta",
      "bloque": "cta",
      "texto": "Guárdalo. Y mándaselo a ese que dice «si está chapada, está chapada».",
      "claves": [
        "Guárdalo",
        "chapada"
      ],
      "cifras": [],
      "inicio": 45.62,
      "fin": 49.812
    }
  ]
}