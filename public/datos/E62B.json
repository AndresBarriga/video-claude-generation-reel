 "escenas": [
  {
   "tipo": "gancho",
   "visual": "gancho",
   "texto": "Le estás dando cuerda. Aparato agarrado, pulgar en la leva. Y justo ahora… se cae.",
   "inicio": 0,
   "fin": 4.661,
   "abre": "ab"
  },
  {
   "tipo": "texto",
   "visual": "corre",
   "texto": "Puede que no frene. Con la leva apretada, la cuerda puede correr… y él, bajar con ella.",
   "inicio": 5.7,
   "fin": 10.605
  },
  {
   "tipo": "texto",
   "visual": "dos",
   "texto": "Tu grigri ayuda a frenar. Pero necesita dos cosas: la leva libre… y tu mano en la cuerda de freno.",
   "inicio": 10.82,
   "fin": 16.757
  },
  {
   "tipo": "texto",
   "visual": "normal",
   "texto": "Lo normal es dar cuerda sin tocar la leva: empujas cuerda hacia el aparato y tiras del otro lado.",
   "inicio": 16.98,
   "fin": 22.301
  },
  {
   "tipo": "texto",
   "visual": "rapido",
   "texto": "¿Y si va a chapar y hay que dar rápido? Pulgar en la leva solo un instante, sin soltar la cuerda de freno… y vuelves.",
   "inicio": 22.52,
   "fin": 28.692
  },
  {
   "tipo": "texto",
   "visual": "misma",
   "texto": "Misma caída. Leva libre, mano en la cuerda.",
   "inicio": 28.9,
   "fin": 31.859
  },
  {
   "tipo": "cierre",
   "visual": "cierre",
   "texto": "El aparato ayuda. La que frena es tu mano.",
   "inicio": 32.08,
   "fin": 34.592
  }
 ],
