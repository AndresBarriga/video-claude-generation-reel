  "escenas": [
    {
      "tipo": "gancho",
      "visual": "gancho",
      "bloque": "gancho",
      "texto": "Te gastas ciento cincuenta euros en unos zapatos que sabes que te van a doler.",
      "claves": [
        "euros",
        "doler"
      ],
      "cifras": [
        "150 €"
      ],
      "inicio": 0,
      "fin": 4.333
    },
    {
      "tipo": "texto",
      "visual": "reencuadre",
      "bloque": "reencuadre",
      "texto": "No es masoquismo… aunque lo parezca. Es para que no quede ni un milímetro de aire.",
      "claves": [
        "masoquismo",
        "aire"
      ],
      "cifras": [],
      "inicio": 4.555,
      "fin": 8.987
    },
    {
      "tipo": "texto",
      "visual": "dentro",
      "bloque": "dentro",
      "texto": "Con aire, al pisar un canto, el pie se dobla dentro y pierdes fuerza. Apretado, pie y gato son una sola pieza.",
      "claves": [
        "fuerza",
        "pieza"
      ],
      "cifras": [],
      "inicio": 9.21,
      "fin": 15.789
    },
    {
      "tipo": "texto",
      "visual": "analogia",
      "bloque": "analogia",
      "texto": "Como subir un bordillo con unas chanclas cinco números más grandes.",
      "claves": [
        "chanclas"
      ],
      "cifras": [],
      "inicio": 16.011,
      "fin": 19.044
    },
    {
      "tipo": "texto",
      "visual": "pisar",
      "bloque": "pisar",
      "texto": "Pero solo funciona si pisas bien: con la punta del dedo gordo, mirando el pie.",
      "claves": [
        "punta",
        "mirando"
      ],
      "cifras": [],
      "inicio": 19.27,
      "fin": 23.864
    },
    {
      "tipo": "texto",
      "visual": "cifras",
      "bloque": "cifras",
      "texto": "Y nos pasamos. En un estudio, cincuenta y cinco de cincuenta y seis escaladores los llevaban demasiado apretados. Y nueve de cada diez tenían dolor de pies al escalar.",
      "claves": [
        "estudio",
        "dolor"
      ],
      "cifras": [
        "55/56",
        "91 %"
      ],
      "inicio": 24.106,
      "fin": 33.418
    },
    {
      "tipo": "texto",
      "visual": "giro",
      "bloque": "giro",
      "texto": "Y con dolor te cuesta confiar en el pie: apoyas rápido, apoyas mal… y a la segunda vía te los quitas.",
      "claves": [
        "confiar",
        "quitas"
      ],
      "cifras": [],
      "inicio": 33.641,
      "fin": 39.463
    },
    {
      "tipo": "texto",
      "visual": "pasos",
      "bloque": "pasos",
      "texto": "Tres reglas. Una: dedos un poco doblados, no en puño. Dos: talón sin aire. Tres: diez minutos de pie en la tienda. Si estás deseando quitártelos, son pequeños.",
      "claves": [
        "doblados",
        "talón",
        "minutos"
      ],
      "cifras": [
        "10 min"
      ],
      "inicio": 39.691,
      "fin": 50.284
    },
    {
      "tipo": "cierre",
      "visual": "cta",
      "bloque": "cta",
      "texto": "Guárdalo para tu próxima compra… y mándaselo al que siempre dice que ya darán de sí.",
      "claves": [
        "guárdalo"
      ],
      "cifras": [],
      "inicio": 50.51,
      "fin": 54.711
    }
  ],
