art": 36.937, "end": 37.583}, {"w": "corto", "start": 37.603, "end": 37.946}, {"w": "y", "start": 37.966, "end": 38.067}, {"w": "muy", "start": 38.087, "end": 38.309}, {"w": "pendiente…", "start": 38.329, "end": 38.915}, {"w": "y", "start": 39.135, "end": 39.219}, {"w": "dando", "start": 39.239, "end": 39.529}, {"w": "cuerda", "start": 39.549, "end": 39.891}, {"w": "rápido", "start": 39.911, "end": 40.252}, {"w": "cuando", "start": 40.272, "end": 40.614}, {"w": "chapas.", "start": 40.634, "end": 40.976}, {"w": "Así", "start": 41.196, "end": 41.406}, {"w": "que", "start": 41.426, "end": 41.637}, {"w": "cuidado", "start": 41.862, "end": 42.265}, {"w": "al", "start": 42.285, "end": 42.424}, {"w": "chapar", "start": 42.444, "end": 42.795}, {"w": "la", "start": 42.815, "end": 42.954}, {"w": "segunda.", "start": 42.974, "end": 43.378}], "escenas": [{"tipo": "gancho", "visual": "gancho", "texto": "Estás chapando la segunda. Si fallas ahora… puedes llegar al suelo.", "inicio": 0, "fin": 4.067, "abre": true}, {"tipo": "texto", "visual": "cuerda", "texto": "Y eso que la primera está chapada. Pero para chapar por encima de la cabeza, sacas metro y medio de cuerda.", "inicio": 4.291, "fin": 9.952}, {"tipo": "texto", "visual": "igual", "texto": "Si fallas, caes lo mismo que si la chapas en la cintura… pero empiezas más abajo. Y en la segunda, más abajo es el suelo.", "inicio": 10.187, "fin": 17.022}, {"tipo": "texto", "visual": "peligrosa", "texto": "Por eso la segunda es la chapa más peligrosa: alto para hacerte daño, bajo para que la cuerda te pare.", "inicio": 17.26, "fin": 22.832}, {"tipo": "texto", "visual": "boca", "texto": "Y si te la pones en la boca para sacar más, ya no te juegas solo el suelo: al caer, se tensa entre tus dientes.", "inicio": 23.073, "fin": 29.159}, {"tipo": "texto", "visual": "cintura", "texto": "Si necesitas la boca, sacas demasiada cuerda. Sube hasta tenerla en la cintura.", "inicio": 29.381, "fin": 33.73}, {"tipo": "texto", "visual": "asegura", "texto": "Y quien asegura: en esta chapa, cerca de la pared, llevándote corto y muy pendiente… y dando cuerda rápido cuando chapas.", "inicio": 33.957, "fin": 40.976}, {"tipo": "cierre", "visual": "cierre", "texto": "Así que cuidado al chapar la segunda.", "inicio": 41.196, "fin": 43.378}]}